apiVersion: aggrega.ai/v1beta1
kind: Plugin
metadata:
    name: helm-renderer
    pluginType: provider
    version: "1.0.0"
    description: Renders IR nodes into Helm chart artifacts.
spec:
    abiVersion: v1alpha1
    provider:
        capabilities:
            - helm
            - compose
    signature:
        type: sigstore-cosign
        signatureRef: oci://hub.aggrega.ai/plugins/helm-renderer:sha256-abc123.sig
        publicKeyRef: oci://hub.aggrega.ai/keys/release.pub
    runtime:
        maxMemoryPages: 256
        timeoutMs: 3000
        hostFunctions:
            - log_message
            - read_config
        configKV:
            render_mode: strict
            indent: "2"
    exports:
        - name: render_node
          operates: emit
          scope: own
          selector: workloads carrying a pod template
        - name: patch_labels
          operates: patch
          scope: host
          selector: all rendered documents
