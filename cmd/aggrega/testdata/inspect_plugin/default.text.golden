Plugin: helm-renderer:1.0.0
Description: Renders IR nodes into Helm chart artifacts.
Plugin: provider/helm-renderer
Plugin type: provider
ABI version: v1beta1
Capabilities: helm, compose
Exports:
  render_node
    operates: emit
    scope: own
    selector: workloads carrying a pod template
  patch_labels
    operates: patch
    scope: host
    selector: all rendered documents
Runtime:
  maxMemoryPages: 256
  timeoutMs: 3000
  hostFunctions:
    - log_message
    - read_config
