apiVersion: aggrega.ai/v1beta1
kind: FeatureRecipe
metadata:
    name: core/metrics-recipe
    version: "1.0.0"
spec:
    capability: helm
    implements: core/metrics:1.0.0
    artifacts:
        servicemonitor.yaml: |
            apiVersion: monitoring.coreos.com/v1
            kind: ServiceMonitor
    injectMapping: |
        {}
    executionScope: boundary
