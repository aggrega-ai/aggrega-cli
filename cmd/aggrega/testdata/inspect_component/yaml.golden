apiVersion: aggrega.ai/v1beta1
kind: Component
metadata:
    name: core/server
    version: "1.0.0"
    labels:
        component.aggrega.ai/type: server
spec:
    schema: |
        values: { port?: int | *8080 }
    usesSchema:
        db:
            selector: 'component.aggrega.ai/type=stateful-server'
