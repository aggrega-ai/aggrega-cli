apiVersion: aggrega.ai/v1alpha1
kind: Recipe
metadata:
    name: core/api-server-recipe
    version: "1.0.0"
spec:
    provider: helm
    implements: core/api-server:1.0.0
    workload: |
        apiVersion: aggrega.ai/v1alpha1
        kind: Workload
    provides:
        endpoint: '{{ .metadata.name }}'
