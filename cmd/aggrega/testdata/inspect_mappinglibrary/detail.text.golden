MappingLibrary: CommonHelmMappings:1.0.0
Description: Reusable Helm value mappings.
Mappings:
  ResourcesBlock
    Use: valuesMapping: { $import: CommonHelmMappings#/mappings/ResourcesBlock }
    resources:
      requests:
        cpu: {{ .values.cpu }}
  ProbesBlock
    Use: valuesMapping: { $import: CommonHelmMappings#/mappings/ProbesBlock }
    livenessProbe:
      httpGet:
        path: /healthz
