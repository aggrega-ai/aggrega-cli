        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/moduleType"
          },
          "nullable": true,
          "metadata": {
            "description": "Optional. Redis modules to enable. Restrictions may apply based on SKU and configuration. [Learn more](https://aka.ms/redis/enterprise/modules)."
          }
        },
        "port": {
          "type": "int",
          "nullable": true,
          "minValue": 10000,
          "maxValue": 10000,
