{
  // The topology of one.json in language version 2.0: each resource keyed by
  // the symbol one.json derives for it, the database written beside its
  // server, and references through symbolic names and format.
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "serverName": {
      "type": "string",
      "defaultValue": "pg-main",
      "minLength": 3,
      "maxLength": 63,
      "metadata": { "description": "The name of the PostgreSQL flexible server." }
    },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" },
    "administratorPassword": { "type": "securestring" },
    "environmentId": { "type": "string" },
    "deployStorage": { "type": "bool", "defaultValue": true },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard_B1ms",
      "allowedValues": [ "Standard_B1ms", "Standard_D2s_v3" ]
    }
  },
  "variables": {
    "databaseName": "appdb"
  },
  "resources": {
    "flexibleservers": {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2022-12-01",
      "name": "[parameters('serverName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "[parameters('skuName')]", "tier": "Burstable" },
      "properties": {
        "administratorLogin": "pgadmin",
        "administratorLoginPassword": "[parameters('administratorPassword')]",
        "version": "16"
      }
    },
    "appdb": {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2022-12-01",
      "name": "[format('{0}/{1}', parameters('serverName'), variables('databaseName'))]",
      "dependsOn": [ "flexibleservers" ],
      "properties": { "charset": "UTF8", "collation": "en_US.utf8" }
    },
    "storageaccounts": {
      "condition": "[parameters('deployStorage')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[format('st{0}', uniqueString(resourceGroup().id))]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": { "name": "Standard_LRS" }
    },
    "web": {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}-web', parameters('serverName'))]",
      "location": "[parameters('location')]",
      "dependsOn": [ "appdb", "storageaccounts" ],
      "properties": {
        "environmentId": "[parameters('environmentId')]",
        "configuration": { "ingress": { "external": true, "targetPort": 8080 } },
        "template": {
          "containers": [
            {
              "name": "web",
              "image": "ghcr.io/example/web:1.4.2",
              "env": [
                { "name": "DB_HOST", "value": "[reference('flexibleservers').fullyQualifiedDomainName]" },
                {
                  "name": "DB_URL",
                  "value": "[format('postgres://{0}:5432/{1}', reference('flexibleservers').fullyQualifiedDomainName, variables('databaseName'))]"
                },
                {
                  "name": "STORAGE_KEY",
                  "value": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', format('st{0}', uniqueString(resourceGroup().id))), '2023-01-01').keys[0].value]"
                },
                { "name": "BANNER", "value": "[[written as text]" }
              ]
            }
          ]
        }
      }
    }
  },
  "outputs": {
    "serverAddress": { "type": "string", "value": "[reference('flexibleservers').fullyQualifiedDomainName]" }
  }
}
