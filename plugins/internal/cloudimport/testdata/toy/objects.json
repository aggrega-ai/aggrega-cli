{
  "parameters": [
    {"name": "stage", "type": "string", "default": "prod"}
  ],
  "resources": [
    {"id": "db", "type": "Toy.Data/servers", "name": "pg-main",
     "properties": {"location": "westeurope", "version": "16"}},
    {"id": "queue", "type": "Toy.Messaging/queues", "name": "orders",
     "properties": {"location": "westeurope",
                    "tags": [{"key": "team", "value": "orders"}, {"key": "stage", "value": {"$param": "stage"}}],
                    "routes": [{"to": "a.example", "port": 80}, {"to": {"$ref": "db", "attr": ["host"]}, "port": 5432}]}}
  ]
}
