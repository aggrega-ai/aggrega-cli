{
  "resources": [
    {"id": "db", "type": "Toy.Data/servers", "name": "pg-main",
     "properties": {"location": "westeurope", "version": "16"}},
    {"id": "search", "type": "Toy.Search/services", "module": {"path": "toy/search", "version": "1.2.0"},
     "properties": {"name": "search-main", "sku": "basic", "replicas": 2, "telemetry": true,
                    "hostName": {"$ref": "db", "attr": ["host"]}}},
    {"id": "worker", "type": "Toy.Compute/workers", "name": "indexer",
     "properties": {"searchEndpoint": {"$ref": "search", "attr": ["endpoint"]}}}
  ]
}
