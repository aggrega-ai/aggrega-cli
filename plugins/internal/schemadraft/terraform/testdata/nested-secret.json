{
  "format_version": "1.0",
  "provider_schemas": {
    "registry.terraform.io/example/ledgers": {
      "resource_schemas": {
        "ex_vault": {
          "version": 0,
          "block": {
            "description": "A vault that keeps entries for its users.",
            "description_kind": "plain",
            "attributes": {
              "name": {"type": "string", "required": true, "description": "The vault's name."},
              "password": {"type": "string", "optional": true, "sensitive": true, "description": "The vault's own password."}
            },
            "block_types": {
              "user": {
                "nesting_mode": "list",
                "block": {
                  "description": "A user the vault admits.",
                  "attributes": {
                    "login": {"type": "string", "required": true, "description": "The user's login."},
                    "password": {"type": "string", "optional": true, "sensitive": true, "description": "The user's password."},
                    "token": {"type": "string", "computed": true, "sensitive": true, "description": "A token read back."}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
