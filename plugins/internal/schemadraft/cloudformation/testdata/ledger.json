{
  "typeName": "AWS::Example::Ledger",
  "description": "A ledger the example service keeps, written for this test. It records entries for its readers.\n\nThis second paragraph is left out of a draft.",
  "sourceUrl": "https://example.com/ledger",
  "definitions": {
    "Capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Mode": {
          "type": "string",
          "enum": ["STANDARD", "BURST"],
          "description": "How the ledger scales under load."
        },
        "ReadUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "How many reads a second the ledger serves."
        }
      },
      "required": ["ReadUnits"]
    },
    "Endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Address": {
          "type": "string",
          "description": "The host name a reader connects to."
        },
        "Port": {
          "type": "integer",
          "description": "The port a reader connects to."
        },
        "Token": {
          "type": "string",
          "description": "The token the endpoint hands a new reader."
        }
      }
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Action": {
          "type": "string",
          "description": "What the rule does to an entry."
        },
        "Children": {
          "type": "array",
          "insertionOrder": false,
          "items": {"$ref": "#/definitions/Rule"},
          "description": "The rules nested under this one."
        }
      }
    }
  },
  "properties": {
    "Arn": {
      "type": "string",
      "description": "The ledger's resource name."
    },
    "Capacity": {
      "$ref": "#/definitions/Capacity",
      "description": "How much the ledger serves. Its members are read at creation."
    },
    "DeletionProtection": {
      "type": "boolean",
      "description": "Whether the ledger refuses to be deleted."
    },
    "Endpoint": {
      "$ref": "#/definitions/Endpoint"
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,40}$",
      "description": "The ledger's own identifier."
    },
    "KmsKeyId": {
      "type": "string",
      "description": "The key that encrypts the ledger."
    },
    "LedgerName": {
      "type": "string",
      "pattern": "^(?!reserved-)[a-z][a-z0-9-]*$",
      "minLength": 3,
      "maxLength": 63,
      "description": "The ledger's name. It is unique in an account."
    },
    "LegacyMode": {
      "type": "boolean",
      "description": "A mode kept for older readers."
    },
    "MasterPassword": {
      "type": "string",
      "minLength": 8,
      "description": "The password of the ledger's first user."
    },
    "Name": {
      "type": "string",
      "description": "A display name for the ledger."
    },
    "Rules": {
      "type": "array",
      "insertionOrder": true,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/Rule"},
      "description": "The rules the ledger applies to each entry."
    },
    "SubnetGroup": {
      "type": "string",
      "relationshipRef": {"typeName": "AWS::Example::SubnetGroup", "propertyPath": "/properties/Name"},
      "description": "The subnet group the ledger is placed in."
    }
  },
  "required": ["Capacity", "Identifier", "SubnetGroup"],
  "readOnlyProperties": [
    "/properties/Arn",
    "/properties/Endpoint/Address",
    "/properties/Endpoint/Port",
    "/properties/Endpoint/Token"
  ],
  "writeOnlyProperties": ["/properties/MasterPassword"],
  "createOnlyProperties": [
    "/properties/Identifier",
    "/properties/KmsKeyId",
    "/properties/LedgerName",
    "/properties/SubnetGroup"
  ],
  "deprecatedProperties": ["/properties/LegacyMode"],
  "primaryIdentifier": ["/properties/Identifier"],
  "additionalProperties": false,
  "tagging": {"taggable": false},
  "handlers": {
    "create": {"permissions": ["example:CreateLedger"]},
    "read": {"permissions": ["example:DescribeLedger"]},
    "delete": {"permissions": ["example:DeleteLedger"]}
  }
}
